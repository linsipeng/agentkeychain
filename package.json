{
  "name": "agentkeychain",
  "version": "0.6.2",
  "description": "Agent-native zero-knowledge credential vault. CLI + MCP Server.",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "agentkeychain": "./bin/agentkeychain"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "test": "bun test",
    "lint": "eslint src tests managed-cloud",
    "build": "bun build src/cli/index.ts --compile --outfile bin/agentkeychain-bin && bun scripts/build-native.ts bin/agentkeychain-secure-store",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "agent",
    "credentials",
    "vault",
    "mcp",
    "zero-knowledge",
    "e2ee"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "libsodium-wrappers": "^0.8.4",
    "libsodium-wrappers-sumo": "^0.8.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "^1.4.4",
    "@types/libsodium-wrappers": "^0.7.14",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "10.14.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@hono/node-server": "2.1.6",
    "hono": "4.13.16",
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9",
    "proxy-addr": "2.0.8",
    "qs": "6.17.1",
    "zod": "4.6.7",
    "minimatch": "11.0.4",
    "brace-expansion": "5.0.12",
    "js-yaml": "4.3.2",
    "ip-address": "10.7.6"
  }
}
